[Desktop Entry]
Categories=AudioVideo;Video;Player;
{{#if comment}}
Comment={{comment}}
{{/if}}
GenericName=Video and music player
Keywords=YouTube;Music;Video;Player;
Exec={{exec}} %u
StartupWMClass={{exec}}
Icon={{icon}}
Name={{name}}
Terminal=false
Type=Application
{{#if mime_type}}
MimeType={{mime_type}}
{{/if}}
Actions=new-window;safe-graphics;

[Desktop Action safe-graphics]
Name=Start with safe graphics
Exec={{exec}} --safe-graphics

[Desktop Action new-window]
Name=New window
Exec={{exec}} --new-window
