# Maintainer: A-EDev

pkgname=flow-desktop-bin
_pkgname=flow-desktop
pkgver=0.1.0beta3
pkgrel=1
# Release tags are v0.1.0-beta3 or v0.1.0; pkgver can't hold a "-".
_tag=${pkgver/beta/-beta}
_tag=${_tag/rc/-rc}
pkgdesc='Privacy-first YouTube and YouTube Music client, the desktop companion to Flow for Android (binary release)'
arch=('x86_64' 'aarch64')
url='https://github.com/Flow-Tube/Flow-Desktop'
license=('GPL-3.0-only')
depends=(
  'cairo'
  'dbus'
  'gcc-libs'
  'gdk-pixbuf2'
  'glib2'
  'glibc'
  'gst-libav'
  'gst-plugins-bad'
  'gst-plugins-base'
  'gst-plugins-good'
  'gtk3'
  'hicolor-icon-theme'
  'libsoup3'
  'nodejs'
  'webkit2gtk-4.1'
)
optdepends=('gst-plugins-ugly: more audio and video codecs'
            'libayatana-appindicator: music controls in the system tray')
provides=("$_pkgname")
conflicts=("$_pkgname")
options=('!strip' '!debug')
source_x86_64=("$pkgname-$pkgver-x86_64.deb::$url/releases/download/v$_tag/Flow_${_tag}_linux_amd64.deb")
source_aarch64=("$pkgname-$pkgver-aarch64.deb::$url/releases/download/v$_tag/Flow_${_tag}_linux_arm64.deb")
sha256sums_x86_64=('9590693b8c4862a0e55ec2d71a56b3685b8b27fc2cafcbd2cee7b2c64660dfcc')
sha256sums_aarch64=('8b50812b8b5102aefe0670cb0731dc4695e2823e92528cb36778e89caa059568')

# --- Shared flow-desktop install steps: keep identical in every PKGBUILD. ---

# The release workflow builds every tag with a "-" (betas, release
# candidates) with src-tauri/tauri.prerelease.conf.json, which renames the app.
_flow_product() {
  if [[ $_tag == *-* ]]; then
    printf 'Flow Beta'
  else
    printf 'Flow'
  fi
}

# Installs the data tree of a Flow .deb into $pkgdir.
_flow_install() {
  local data=$1 product resdir desktop bin
  product=$(_flow_product)
  resdir="$pkgdir/usr/lib/$product"
  desktop="$pkgdir/usr/share/applications/$product.desktop"

  cp -a --no-preserve=ownership "$data/usr" "$pkgdir/"
  if [[ ! -f $resdir/sidecar/integrity.cjs || ! -f $desktop ]]; then
    error "The .deb does not have the expected '$product' layout."
    return 1
  fi

  # The AUR ships one name for every channel. Releases up to 0.1.0-beta3
  # install /usr/bin/flow, which belongs to the AUR's flow and flow-bin
  # packages; later ones install flow-desktop, or flow-desktop-beta for betas.
  local bin
  for bin in flow flow-desktop-beta; do
    if [[ -e $pkgdir/usr/bin/$bin ]]; then
      mv "$pkgdir/usr/bin/$bin" "$pkgdir/usr/bin/flow-desktop"
    fi
  done
  sed -Ei 's/^(Exec|StartupWMClass)=flow(-desktop-beta)?( |$)/\1=flow-desktop\3/' "$desktop"
  if [[ ! -x $pkgdir/usr/bin/flow-desktop ]] ||
    grep -E '^Exec=' "$desktop" | grep -Evq '^Exec=flow-desktop( |$)'; then
    error "Could not point $product.desktop at flow-desktop."
    return 1
  fi

  # Tells Flow that pacman owns its updates, so the in-app updater stays off.
  install -m644 /dev/null "$resdir/distro-managed"
}

# --- End of shared steps. ---

prepare() {
  mkdir -p deb-data
  bsdtar -xf data.tar.* -C deb-data
}

package() {
  _flow_install "$srcdir/deb-data"
}
